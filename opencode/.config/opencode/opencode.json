{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "~/repos/skills"
    ]
  },
  "experimental": {
    "mcp_timeout": 120000
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "zod": {
      "type": "remote",
      "url": "https://mcp.inkeep.com/zod/mcp",
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true
    },
    "cloudwatch": {
      "type": "local",
      "command": [
        "awslabs.cloudwatch-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "AWS_PROFILE": "{env:AWS_PROFILE}",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "n8n-mcp": {
      "type": "remote",
      "url": "{env:N8N_MCP_URL}",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      }
    }
  }
}
